{
  "name": "@mindfiredigital/page-builder-web-component",
  "description": "UI Page builder Web-Component",
  "private": false,
  "version": "5.0.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindfiredigital/page-builder.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "start": "serve dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "pagebuilder",
    "page-builder-web-component",
    "rich-page-builder",
    "html-editor",
    "typescript",
    "react",
    "framework",
    "cli",
    "javascript",
    "npm-package",
    "block-editor",
    "visual-editor",
    "no-code",
    "low-code",
    "component-based",
    "responsive-design",
    "components",
    "component",
    "react-component",
    "angular",
    "ui",
    "vue",
    "modern",
    "plugin",
    "eslint",
    "web",
    "webpack",
    "css"
  ],
  "dependencies": {
    "@mindfiredigital/page-builder": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "serve": "^14.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
